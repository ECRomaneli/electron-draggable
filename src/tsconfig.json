{
  "compilerOptions": {
    "target": "es2020",
    "module": "node16",
    "lib": ["ES2020", "DOM"],
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node16",
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "sourceMap": true
  },
  "include": ["**/*.ts"],
}
